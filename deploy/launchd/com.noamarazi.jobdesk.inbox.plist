<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The inbound half, added 24.08.2026. The morning pass delivers a shortlist at
  06:00; this is what notices which postings Noam pressed ✅ on and cuts the CV
  for those, and only those.

  Why a second job rather than one: the two run on completely different clocks.
  The pass is one long run a day and it is expensive; this is a one-second poll
  that has to happen soon after a button is pressed and costs nothing when
  nothing was. Folding them together would mean either a digest every fifteen
  minutes or a CV that arrives tomorrow.

  StartInterval and not StartCalendarInterval: there is no hour at which a
  press happens. The interval is how long Noam waits to see that his press
  registered, and 900 seconds — the first value here — was wrong for a reason
  worth writing down: he pressed, nothing on the screen changed for fifteen
  minutes, and he reported the buttons as broken. They were not. A control with
  no feedback is a broken control whatever the code does, so the interval is 60
  seconds now and the press marks the message it was pressed on. One poll that
  finds nothing is a single HTTP request and about a second of a core.

  With Power Nap the poll runs inside the short wake windows, which is exactly
  what the timeout in the wrapper is for.

  Nothing is lost when this does not run. Telegram keeps an unacknowledged
  update for 24 hours and hands it back until the stored cursor moves past it,
  so a machine that was shut all evening finds every press still waiting.

  Same rule as the other job: this file is not installed by anything. Copying
  it into ~/Library/LaunchAgents is a deliberate act by a human, and so is
  removing it.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.noamarazi.jobdesk.inbox</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/noamarazi/job-desk/deploy/launchd/run-inbox.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/noamarazi/job-desk</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DESK_HOME</key>
        <string>/Users/noamarazi/job-desk</string>

        <!-- Live judgements, not replayed cassettes. A replayed tailoring
             returns a recorded document that looks exactly like a real one. -->
        <key>DESK_ENGINE</key>
        <string>claude-code</string>

        <!-- One poll cuts at most the documents Noam pressed for since the last
             one, which in practice is one or two. -->
        <key>DESK_INBOX_BUDGET_USD</key>
        <string>1.00</string>

        <!-- Longer than the interval, and that is not a mistake. launchd runs
             one copy of a label at a time: while a poll is still working, the
             next interval does not start a second one, it simply waits. So this
             number does not have to fit inside sixty seconds — and it must not,
             because a ✅ press cuts a CV inside this run and a model call is not
             a one-second act. What it bounds is a poll that hung, which on an
             unattended job every minute is the failure that would otherwise
             leave a process behind and never come back. -->
        <key>DESK_INBOX_TIMEOUT_SECONDS</key>
        <string>600</string>

        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>ExitTimeOut</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/noamarazi/job-desk/runs/inbox.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/noamarazi/job-desk/runs/inbox.err.log</string>
</dict>
</plist>
