# Nothing here is needed for `uv run desk demo` — the offline path uses cassettes.

# Engine selection: replay (default) | claude-code | api
DESK_ENGINE=replay

# Set to 1 to write cassettes while running against a live engine.
DESK_RECORD=0

# Only for DESK_ENGINE=api. Credentials also resolve from an `ant auth login`
# profile, which is preferred over a key in a file.
# ANTHROPIC_API_KEY=

# Where data/ and runs/ live. Defaults to the repo root.
# DESK_HOME=
